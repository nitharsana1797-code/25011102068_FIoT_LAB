--cpu Cortex-M3
"uart_stm32\startup_stm32f103xb.o"
"uart_stm32\main.o"
"uart_stm32\stm32f1xx_it.o"
"uart_stm32\stm32f1xx_hal_msp.o"
"uart_stm32\stm32f1xx_hal_gpio_ex.o"
"uart_stm32\stm32f1xx_hal_uart.o"
"uart_stm32\stm32f1xx_hal.o"
"uart_stm32\stm32f1xx_hal_rcc.o"
"uart_stm32\stm32f1xx_hal_rcc_ex.o"
"uart_stm32\stm32f1xx_hal_gpio.o"
"uart_stm32\stm32f1xx_hal_dma.o"
"uart_stm32\stm32f1xx_hal_cortex.o"
"uart_stm32\stm32f1xx_hal_pwr.o"
"uart_stm32\stm32f1xx_hal_flash.o"
"uart_stm32\stm32f1xx_hal_flash_ex.o"
"uart_stm32\stm32f1xx_hal_exti.o"
"uart_stm32\system_stm32f1xx.o"
--strict --scatter "UART_stm32\UART_stm32.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "UART_stm32.map" -o UART_stm32\UART_stm32.axf