--cpu=Cortex-M4.fp.sp
"http_protocol\startup_stm32f410rx.o"
"http_protocol\main.o"
"http_protocol\stm32f4xx_it.o"
"http_protocol\stm32f4xx_hal_msp.o"
"http_protocol\stm32f4xx_hal_uart.o"
"http_protocol\stm32f4xx_hal_rcc.o"
"http_protocol\stm32f4xx_hal_rcc_ex.o"
"http_protocol\stm32f4xx_hal_flash.o"
"http_protocol\stm32f4xx_hal_flash_ex.o"
"http_protocol\stm32f4xx_hal_flash_ramfunc.o"
"http_protocol\stm32f4xx_hal_gpio.o"
"http_protocol\stm32f4xx_hal_dma_ex.o"
"http_protocol\stm32f4xx_hal_dma.o"
"http_protocol\stm32f4xx_hal_pwr.o"
"http_protocol\stm32f4xx_hal_pwr_ex.o"
"http_protocol\stm32f4xx_hal_cortex.o"
"http_protocol\stm32f4xx_hal.o"
"http_protocol\stm32f4xx_hal_exti.o"
"http_protocol\system_stm32f4xx.o"
--strict --scatter "http_protocol\http_protocol.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "http_protocol.map" -o http_protocol\http_protocol.axf